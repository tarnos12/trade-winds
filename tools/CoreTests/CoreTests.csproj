<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless runner for the pure C# sim core (ADR 0002): compiles Assets/TradeWinds/Core and its
    Edit Mode tests outside Unity so they run with `dotnet test tools/CoreTests`.
    Unity remains the primary runner (Test Runner → Edit Mode).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_INCLUDE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/TradeWinds/Core/**/*.cs" />
    <Compile Include="../../Assets/TradeWinds/Core.Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
